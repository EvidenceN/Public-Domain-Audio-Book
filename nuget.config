<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- NeoUI Extra (github.com/EvidenceN/NEO-UI-EXTRA) is not published to a feed yet: its four packages, built from that
       repository's main branch with scripts/pack.sh, are kept in ./packages and found here before nuget.org. To take a
       newer build: run scripts/pack.sh there with the next FORK_VERSION and replace the files. See docs/UI.md. -->
  <packageSources>
    <clear />
    <add key="neoui-extra" value="./packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="neoui-extra">
      <package pattern="NeoUI.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
