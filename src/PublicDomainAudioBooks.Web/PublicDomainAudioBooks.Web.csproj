<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- An unknown component tag would otherwise render silently as plain HTML (NeoUI Extra's consumer guide). -->
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <!-- NeoUI Extra brings the NeoUI fork (components, primitives, icons) with it; they are used together, one version. -->
    <PackageReference Include="NeoUI.Extra.Blazor" Version="4.1.38.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PublicDomainAudioBooks.Tests" />
  </ItemGroup>

</Project>
